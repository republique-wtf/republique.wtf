// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../services/infra/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Elu {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  dateNaissance DateTime
  photoProfil   String?
  uri           String   @unique
  jobs          Job[]

  @@map("elus")
}

model Job {
  id                  String    @id @default(cuid())
  eluId               String
  elu                 Elu       @relation(fields: [eluId], references: [id])
  dateDebut           DateTime
  dateFin             DateTime?
  estFonctionPublique Boolean
  estPosteElu         Boolean
  nom                 String
  categorie           String

  @@map("jobs")
}
